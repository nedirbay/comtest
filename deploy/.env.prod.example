# Copy to deploy/.env.prod. Never commit the copy. See backend/README.md for what each value does.
IMAGE_TAG=change-me
PUBLIC_API_URL=https://api.example.tm
PUBLIC_ADMIN_URL=https://admin.example.tm
# STORAGE_PUBLIC_ORIGIN=https://storage.example.tm
MIGRATIONS_CONNECTION=Host=db.internal;Database=comtest;Username=comtest_owner;Password=change-me;SSL Mode=VerifyFull

# Read by the API itself.
ConnectionStrings__Default=Host=db.internal;Database=comtest;Username=comtest_app;Password=change-me;SSL Mode=VerifyFull
Jwt__Issuer=https://api.example.tm
Jwt__ActiveKeyId=prod-1
Jwt__SigningKeys__0__KeyId=prod-1
Jwt__SigningKeys__0__PrivateKeyPem=change-me
DataProtection__CertificatePfxBase64=change-me
DataProtection__CertificatePassword=change-me
Email__Smtp__Host=smtp.example.tm
Storage__ServiceUrl=https://storage.example.tm
Storage__AccessKey=change-me
Storage__SecretKey=change-me
Storage__Bucket=comtest
Auth__FrontendBaseUrl=https://example.tm
Tenancy__BaseDomain=example.tm
Cors__AllowedOrigins__0=https://admin.example.tm
# The reverse proxy and the storefront's server both reach the API from this network.
ForwardedHeaders__KnownNetworks__0=172.30.0.0/24
