# Copy to .env. NUXT_PUBLIC_* values are visible in the browser: no secrets there.
NUXT_PUBLIC_API_URL=http://localhost:5050
# Picks the store during development. The API ignores this header in production.
NUXT_PUBLIC_DEV_TENANT=demo
# Where the server reaches the API, when that differs from the public address.
# NUXT_API_INTERNAL_URL=http://api:8080
# NUXT_PUBLIC_SENTRY_DSN=
