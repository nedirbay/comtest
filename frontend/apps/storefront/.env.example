# Copy to .env. NUXT_PUBLIC_* values are visible in the browser: no secrets there.
NUXT_PUBLIC_API_URL=http://localhost:5050
# Picks the store during development. The API ignores this header in production.
NUXT_PUBLIC_DEV_TENANT=demo
# Where the server reaches the API, when that differs from the public address.
# NUXT_API_INTERNAL_URL=http://api:8080
# NUXT_PUBLIC_SENTRY_DSN=
# Where the "open admin panel" link leads after accepting a staff invitation.
# NUXT_PUBLIC_ADMIN_URL=https://admin.example.tm
# `report` only logs what the content security policy would block, and `enforce` blocks it.
# NUXT_CSP_MODE=enforce
# Non-https hosts for product pictures, separated by spaces. https hosts are always allowed.
# NUXT_CSP_EXTRA_IMAGE_ORIGINS=http://localhost:9000
