# Copy to .env.local. Every VITE_* value ends up in the browser bundle: no secrets here.
VITE_API_URL=http://localhost:5050
# VITE_SENTRY_DSN=
# Hosts the page may talk to or show pictures from besides the API, separated by spaces. Uploads go
# straight to object storage, so production has to name that host here or they will be blocked.
# VITE_CSP_EXTRA_ORIGINS=https://storage.example.tm
