{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://api.comtest.local",
    "Audience": "comtest-api",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 14,
    "SessionMaxDays": 30,
    "RefreshReuseGraceSeconds": 10,
    "TwoFactorChallengeMinutes": 5,
    "BreachedPasswordCheckEnabled": true
  },
  "RateLimiting": {
    "GlobalPerMinute": 300,
    "TenantPerMinute": 6000,
    "LoginPerMinute": 10,
    "AccountActionPerMinute": 5,
    "RefreshPerMinute": 30,
    "SmsPerHour": 10,
    "CheckoutPerMinute": 10,
    "TrackingPerMinute": 30,
    "ReportExportPerMinute": 10,
    "PromoCodePerMinute": 15
  },
  "Checkout": {
    "PendingOrderHours": 48,
    "MaxOpenGuestOrdersPerPhone": 3
  },
  "Tenancy": {
    "BaseDomain": "comtest.local",
    "AllowTenantHeader": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  }
}
